# Application Settings
APP_ENV=production
PROJECT_NAME="TaskHub — Hệ thống quản lý công việc (Task Management API)"
API_V1_STR=/api/v1
DEBUG=False

# Security & JWT (REQUIRED: Generate a strong secret key with min 32 chars)
SECRET_KEY=generate-a-strong-secret-key-for-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Configuration (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=taskhub

# Database Connection (PostgreSQL asyncpg for production / docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/taskhub
# Or for local SQLite development:
# DATABASE_URL=sqlite+aiosqlite:///./taskhub.db

# Redis Caching
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
